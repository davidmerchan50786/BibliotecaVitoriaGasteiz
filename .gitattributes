###############################################################################
# GITATTRIBUTES OPTIMIZADO PARA PROYECTO BIBLIOTECA VITORIA-GASTEIZ
# Autor: David - DAM UCAM
# Fecha: Febrero 2026
# Propósito: Evitar problemas de line endings entre Windows y Git
###############################################################################

###############################################################################
# REGLA BASE: Auto-detectar archivos de texto
###############################################################################
* text=auto

###############################################################################
# ARCHIVOS C# Y .NET: FORZAR CRLF (Windows)
# Estos archivos SIEMPRE deben tener CRLF porque Visual Studio los requiere
###############################################################################
*.cs        text eol=crlf diff=csharp
*.Designer.cs text eol=crlf diff=csharp
*.resx      text eol=crlf
*.settings  text eol=crlf

###############################################################################
# ARCHIVOS DE PROYECTO Y SOLUCIÓN: FORZAR CRLF
###############################################################################
*.sln       text eol=crlf
*.csproj    text eol=crlf
*.vbproj    text eol=crlf
*.vcxproj   text eol=crlf
*.fsproj    text eol=crlf
*.wixproj   text eol=crlf
*.sqlproj   text eol=crlf

###############################################################################
# ARCHIVOS DE CONFIGURACIÓN .NET: FORZAR CRLF
###############################################################################
*.config    text eol=crlf
*.props     text eol=crlf
*.targets   text eol=crlf
*.nuspec    text eol=crlf
packages.config text eol=crlf

###############################################################################
# ARCHIVOS DE DOCUMENTACIÓN: FORZAR CRLF (para este proyecto Windows)
# Si trabajaras en multiplataforma, usa eol=lf
###############################################################################
*.md        text eol=crlf
*.txt       text eol=crlf
README*     text eol=crlf
CHANGELOG*  text eol=crlf
LICENSE*    text eol=crlf

###############################################################################
# ARCHIVOS WEB (si los usas): PREFERIR LF (estándar web)
###############################################################################
*.html      text eol=lf
*.css       text eol=lf
*.js        text eol=lf
*.json      text eol=lf
*.xml       text eol=lf

###############################################################################
# ARCHIVOS UNIX/LINUX: FORZAR LF
###############################################################################
*.sh        text eol=lf

###############################################################################
# ARCHIVOS BINARIOS: NO CONVERTIR LINE ENDINGS
###############################################################################

# Imágenes
*.jpg       binary
*.jpeg      binary
*.png       binary
*.gif       binary
*.bmp       binary
*.ico       binary
*.svg       binary
*.webp      binary

# Documentos binarios
*.pdf       binary
*.doc       binary
*.docx      binary
*.xls       binary
*.xlsx      binary
*.ppt       binary
*.pptx      binary

# Archivos .NET compilados
*.dll       binary
*.exe       binary
*.pdb       binary
*.suo       binary
*.user      binary

# Base de datos SQLite (CRÍTICO)
*.db        binary
*.sqlite    binary
*.sqlite3   binary

# Fuentes
*.ttf       binary
*.otf       binary
*.woff      binary
*.woff2     binary
*.eot       binary

# Archivos comprimidos
*.zip       binary
*.7z        binary
*.rar       binary
*.tar       binary
*.gz        binary

# Recursos compilados
*.resources binary

###############################################################################
# MERGE STRATEGY PARA ARCHIVOS DE PROYECTO
# Evita conflictos de merge marcando algunos archivos como binarios
###############################################################################
*.sln       merge=binary
*.csproj    merge=binary

###############################################################################
# DIFF BEHAVIOR PARA DOCUMENTOS (OPCIONAL)
# Convierte documentos binarios a texto antes de hacer diff
###############################################################################
*.doc       diff=astextplain
*.DOC       diff=astextplain
*.docx      diff=astextplain
*.DOCX      diff=astextplain
*.pdf       diff=astextplain
*.PDF       diff=astextplain

###############################################################################
# NOTAS IMPORTANTES
###############################################################################
# 
# ¿QUÉ HACE ESTE ARCHIVO?
# 1. Archivos .cs, .sln, .csproj → SIEMPRE CRLF (Visual Studio feliz)
# 2. Archivos .md, .txt → CRLF (consistencia en Windows)
# 3. Archivos .db, .dll, .exe → BINARIO (no tocar)
# 4. Al hacer commit → Git guarda con LF internamente
# 5. Al hacer checkout → Git convierte automáticamente a CRLF
#
# ¿POR QUÉ ESTO SOLUCIONA EL PROBLEMA?
# - En tu disco local: SIEMPRE CRLF
# - En el repositorio Git: LF (estándar)
# - Al clonar en otra máquina Windows: Vuelve a CRLF automáticamente
# - Visual Studio NO mostrará el MessageBox molesto
#
# ¿QUÉ PASA SI YA HICISTE COMMIT CON LINE ENDINGS MALOS?
# Ejecuta esto UNA VEZ después de aplicar este .gitattributes:
#   git add --renormalize .
#   git commit -m "fix: normalizar line endings según .gitattributes"
#
###############################################################################
